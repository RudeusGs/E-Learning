{
  "name": "@elearning/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run type-check && vite build",
    "preview": "vite preview --host 0.0.0.0",
