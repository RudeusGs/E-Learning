# Docker Compose local/demo defaults only. Never put production secrets here.
POSTGRES_DB=elearning
POSTGRES_USER=elearning
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
ASPNETCORE_ENVIRONMENT=Development
REVERSE_PROXY_KNOWN_NETWORK=172.16.0.0/12

# A valid, secure key (>=32 bytes) is required for JWT signing in all environments.
Jwt__Key=
