    <!-- Loading -->
    <div v-if="loading" class="space-y-6">
      <div class="h-4 w-52 animate-pulse rounded bg-[#eae3e2]" />
      <div class="h-40 animate-pulse rounded-2xl bg-[#eee8e7]" />

