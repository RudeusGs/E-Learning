import { beforeEach, describe, expect, it, vi } from 'vitest'

import * as authApi from './auth.api'
import { useAuthStore } from './auth.store'
import type { AuthSessionResponse } from './models/AuthSessionResponse'

vi.mock('./auth.api', () => ({
