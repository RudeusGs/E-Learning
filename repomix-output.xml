                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="m4 7 8 6 8-6" />
                    </svg>
                    <span class="truncate">{{ student.email }}</span>
                  </span>

                  <span class="text-xs font-semibold text-[#9a8987]">
                    ID #{{ student.id }}
                  </span>

                  <span class="text-xs font-semibold text-[#9a8987]">
                    {{ activeEnrollments.length }} khóa đang gán
                  </span>
                </div>
              </div>
            </div>

            <RouterLink
              :to="{ path: '/admin/progress', query: { studentId: String(student.id) } }"
              class="inline-flex h-10 shrink-0 items-center justify-center gap-2 self-start rounded-lg border border-[#d5a3a9] bg-white px-4 text-sm font-bold text-[#a0001c] transition hover:bg-[#fff3f4] md:self-auto"
            >
              <svg
