                      <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                    </svg>
                    {{ saving ? 'Đang lưu…' : isEditing ? 'Lưu thay đổi' : 'Lưu câu hỏi' }}
                  </button>
                </div>
              </form>
            </section>
          </aside>
        </div>
      </template>
    </template>
  </section>
</template>
