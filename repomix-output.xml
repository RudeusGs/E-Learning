      @click="addOption"
    >
      + Thêm lựa chọn
    </button>
    <ProblemAlert class="mt-3" :problem="problem" />
    <button
      class="mt-3 rounded-lg bg-slate-900 px-3 py-2 text-sm text-white disabled:opacity-60"
      :disabled="loading"
    >
      {{ loading ? 'Đang lưu…' : 'Lưu câu hỏi' }}
    </button>
  </form>
