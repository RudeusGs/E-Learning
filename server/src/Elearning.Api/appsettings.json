{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=elearning;Username=elearning;Password=change-me-local-only"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "Elearning.Api",
    "Audience": "Elearning.Client",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 30,
    "ConcurrentRefreshGraceSeconds": 5
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 10,
    "RefreshPermitLimit": 30,
    "StudentInteractionPermitLimit": 120
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}